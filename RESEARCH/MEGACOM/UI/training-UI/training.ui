  <property name="styleSheet">
   <string>QWidget { background:#0B1220; color:#DCE9FA; font-family:&quot;Pretendard&quot;, &quot;맑은 고딕&quot;; font-size:10pt; } QGroupBox { background:#142137; border:1px solid #293D58; border-radius:15px; margin-top:14px; padding:12px; font-weight:bold; } QGroupBox::title { subcontrol-origin:margin; left:16px; padding:0 6px; color:#8EC5FF; } QGroupBox QWidget { background:transparent; } QLineEdit,QComboBox,QSpinBox,QDoubleSpinBox,QDateEdit,QPlainTextEdit,QTableWidget { background:#0B1220; border:1px solid #344965; border-radius:5px; padding:5px; } QPushButton { background:#176B70; border-radius:6px; padding:9px; font-weight:bold; } QPushButton:disabled { background:#293548; color:#77879B; } QPushButton#btnStop { background:#843B4B; } QHeaderView::section { background:#20334D; color:#DCE9FA; padding:6px; border:0; } QProgressBar { border:1px solid #344965; border-radius:5px; text-align:center; } QProgressBar::chunk { background:#149E96; } QLabel#lblTitle { font-size:20pt; font-weight:bold; color:#8EC5FF; }
QPushButton#btnStart { background-color:#007A43; color:#FFFFFF; border:2px solid #40D98B; font-size:11pt; font-weight:bold; padding:10px; }
QPushButton#btnStart:hover { background-color:#008A49; }
QPushButton#btnStart:pressed { background-color:#005C32; }
QPushButton#btnStop { background-color:#B91C1C; color:#FFFFFF; border:2px solid #F87171; font-size:11pt; }
QPushButton#btnStop:hover { background-color:#C62828; }
QPushButton#btnStart:disabled, QPushButton#btnStop:disabled { background-color:#374151; color:#B9C3D0; border:1px solid #64748B; }
QGroupBox QComboBox#cmbModel { background-color:#174EA6; color:#FFFFFF; border:2px solid #64B5F6; border-radius:5px; font-size:11pt; font-weight:bold; padding:7px 12px; min-height:25px; }
QGroupBox QComboBox#cmbModel:hover { background-color:#1565C0; }
QComboBox#cmbModel::drop-down { width:28px; border-left:1px solid #64B5F6; }
QComboBox#cmbModel QAbstractItemView { background-color:#172B45; color:#FFFFFF; selection-background-color:#1565C0; selection-color:#FFFFFF; border:2px solid #64B5F6; outline:0; }
QComboBox#cmbModel:disabled { background-color:#374151; color:#D1D5DB; border:1px solid #64748B; }

QPlainTextEdit#txtLog { font-family:&quot;Pretendard&quot;, &quot;맑은 고딕&quot;; font-size:10pt; font-weight:normal; }

/* Dark popup menus and calendar */
QComboBox QAbstractItemView, QGroupBox QComboBox QAbstractItemView {
 background-color:#172B45; color:#F1F5FB; selection-background-color:#174EA6; selection-color:#FFFFFF; border:1px solid #45658A; outline:0;
}
QComboBox QAbstractItemView::item { min-height:26px; padding:4px 8px; }
QCalendarWidget, QGroupBox QCalendarWidget { background-color:#142137; color:#F1F5FB; }
QCalendarWidget QWidget, QGroupBox QCalendarWidget QWidget { background-color:#142137; color:#F1F5FB; }
QCalendarWidget QAbstractItemView, QGroupBox QCalendarWidget QAbstractItemView { background-color:#172B45; alternate-background-color:#20334D; color:#F1F5FB; selection-background-color:#174EA6; selection-color:#FFFFFF; }
QCalendarWidget QAbstractItemView:disabled { color:#8494AC; }
QCalendarWidget QToolButton { background-color:#20334D; color:#FFFFFF; border:1px solid #344965; padding:4px; }
QCalendarWidget QToolButton:hover { background-color:#174EA6; }
QCalendarWidget QMenu { background-color:#172B45; color:#FFFFFF; }
QCalendarWidget QMenu::item:selected { background-color:#174EA6; color:#FFFFFF; }
QCalendarWidget QSpinBox { background-color:#172B45; color:#FFFFFF; }

QComboBox#cmbViewHorizon { background:#174EA6; color:white; border:1px solid #64B5F6; font-weight:bold; padding:5px 12px; }
</string>
